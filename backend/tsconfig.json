{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2021", "strict": true, "declaration": false,
    "emitDecoratorMetadata": true, "experimentalDecorators": true, "esModuleInterop": true,
    "sourceMap": true, "outDir": "./dist", "baseUrl": "./", "skipLibCheck": true,
    "noImplicitAny": true, "strictNullChecks": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*.ts"]
}
